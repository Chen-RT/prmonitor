PORT=4177
PR_MONITOR_DEFAULT_BITBUCKET_URL=https://bitbucket.example.com

# Optional. Desktop builds automatically use the app data directory.
# PR_MONITOR_DATA_DIR=/absolute/path/to/pr-monitor-data

# Optional. Override the bundled skill path during local development.
# BITBUCKET_PR_REVIEW_SKILL_DIR=/absolute/path/to/bitbucket-pr-review

# Optional. Override Codex CLI path when auto-detection fails.
# Can be a directory or a concrete executable path.
# PR_MONITOR_CODEX_PATH=/absolute/path/to/codex
